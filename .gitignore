# ---------------------------------------------------------------------------
# Project-local CAT artifacts and source repositories
# ---------------------------------------------------------------------------
# Stable template directories use tracked .gitkeep files; numbered Room directories
# (Room1, Room2, ...) are created on demand and must not be tracked.
# Project-specific contents belong to the workspace, not to this repository.
/Lifecycle/**
/Docs/**
/TestModels/**
/Room0/**
/Room[1-9]*/

# ---------------------------------------------------------------------------
# Project-specific Copilot/runtime selections
# ---------------------------------------------------------------------------
# Common skills are tracked. Technology skills copied into .github/skills by
# cat_install.py are a per-project selection; the canonical skill pool remains
# tracked under .cat-system/skills/.
/.github/skills/tech-*/
# Registered external technology Skills whose upstream names do not use tech-*.
/.github/skills/docker-project-foundations/
/.github/skills/docker-build-strategies/
/.github/skills/docker-compose-patterns/
/.github/skills/docker-destructive-guardrails/
/.github/skills/*-adapter/

# Project adapters/extensions are local to the project using this template.
/.cat-system/extensions/**

# ---------------------------------------------------------------------------
# CAT execution evidence and generated local state
# ---------------------------------------------------------------------------
**/.cat-flow/

# ---------------------------------------------------------------------------
# Local secrets / environment configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template

# ---------------------------------------------------------------------------
# Language/tool caches and generated output used by the CAT-TDD workspace
# ---------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.tox/
.nox/
.hypothesis/
.direnv/
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml
.nyc_output/
.venv/
venv/
node_modules/
dist/
build/
tmp/
temp/
*.tmp
*.log

# ---------------------------------------------------------------------------
# Editor / OS-local state
# ---------------------------------------------------------------------------
.vscode/
.idea/
.fleet/
.zed/
.history/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
