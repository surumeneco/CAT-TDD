# ---------------------------------------------------------------------------
# Project-local CAT artifacts and source repositories
# ---------------------------------------------------------------------------
# Stable template directories use tracked .gitkeep files; numbered Room directories
# (Room1, Room2, ...) are created on demand and must not be tracked.
# Project-specific contents belong to the workspace, not to this repository.
/Lifecycle/**
/Docs/**
/TestModels/**
/Room0/**
/Room[1-9]*/

# Keep the template skeleton without opening project-specific Work directories.
!/Lifecycle/CAT/
!/Lifecycle/CAT/Candidates/
!/Lifecycle/CAT/Draft/
!/Lifecycle/CAT/Reviews/
!/Lifecycle/Issues/
!/Lifecycle/Issues/*/
!/Lifecycle/REF/
!/Lifecycle/REF/Scopes/
!/Lifecycle/TDD/
!/Lifecycle/TDD/Results/
!/Lifecycle/Tasks/
!/Lifecycle/Tasks/*/
!/Lifecycle/Works/
!/Lifecycle/Works/*/
!/Lifecycle/**/.gitkeep
!/Docs/Constraints/
!/Docs/Decisions/
!/Docs/Processes/
!/Docs/*/.gitkeep
!/TestModels/.gitkeep
!/Room0/.gitkeep

# CAT-TDD's own approved technical Source remains tracked; all private
# decisions and upstream-development Draft/Candidate artifacts stay ignored.
!/Docs/Constraints/cat.compiler.json-instant.domain-spec.md

# Non-distributable local development candidates are not public contract docs.
/docs/cat/**

# ---------------------------------------------------------------------------
# Project-specific Copilot/runtime selections
# ---------------------------------------------------------------------------
# Common skills are tracked. Technology skills copied into .github/skills by
# cat_install.py are a per-project selection; the canonical skill pool remains
# tracked under .cat-system/skills/.
/.github/skills/cat-tdd-entry/
/.github/skills/tech-*/
# This published inspector is shipped and checked against the canonical source.
/.github/skills/tech-typescript/**
!/.github/skills/tech-typescript/
!/.github/skills/tech-typescript/SKILL.md
!/.github/skills/tech-typescript/scripts/
!/.github/skills/tech-typescript/scripts/cat_typescript_conformance.py
# Registered external technology Skills whose upstream names do not use tech-*.
/.github/skills/docker-project-foundations/
/.github/skills/docker-build-strategies/
/.github/skills/docker-compose-patterns/
/.github/skills/docker-destructive-guardrails/
/.github/skills/*-adapter/

# Native Codex / Claude discovery copies are generated from .cat-system and
# should not be committed as independent sources of truth.
# Per-project selections (including external technology skill names):
/.agents/skills/*/
/.claude/skills/*/
/.claude/agents/

# Project adapters/extensions are local to the project using this template.
/.cat-system/extensions/**
!/.cat-system/extensions/.gitkeep

# ---------------------------------------------------------------------------
# CAT execution evidence and generated local state
# ---------------------------------------------------------------------------
**/.cat-flow/
/.gradle-task-cache/

# ---------------------------------------------------------------------------
# Local secrets / environment configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template

# ---------------------------------------------------------------------------
# Language/tool caches and generated output used by the CAT-TDD workspace
# ---------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.tox/
.nox/
.hypothesis/
.direnv/
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml
.nyc_output/
.venv/
venv/
node_modules/
dist/
build/
tmp/
temp/
*.tmp
*.log

# ---------------------------------------------------------------------------
# Editor / OS-local state
# ---------------------------------------------------------------------------
.vscode/
.idea/
.fleet/
.zed/
.history/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Installed workspace entrypoints are local; .cat-system/entrypoints is canonical.
/AGENTS.md
/CLAUDE.md
